{
  "name": "informs_landing_page",
  "version": "1.0.0",
  "description": "Website and board dashboard for the Santa Clara University INFORMS student chapter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "reset-board": "node --env-file-if-exists=.env server/scripts/reset-board.js"
  },
  "dependencies": {
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
