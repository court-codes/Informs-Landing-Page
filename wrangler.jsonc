{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "informs-landing-page",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  // The live database and photo storage. "remote": true makes `npm run dev` use them too.
  "d1_databases": [{ "binding": "DB", "database_name": "informs-landing-page-db", "database_id": "576af4ee-2719-4191-b151-0e906c7c86f3", "remote": true }],
  "kv_namespaces": [{ "binding": "UPLOADS", "id": "8e6b16060d9f40709c26e725830e7dc0", "remote": true }],
  "observability": { "enabled": true }
}
