# Copy this file to .env and fill in the values you need.

# Port for the API server (and the whole site in production).
PORT=3001

# Optional: secret used by the Google Forms Apps Scripts to report completions.
# Leave blank to have the site generate one (see Analytics -> Google Forms connection).
FORM_WEBHOOK_SECRET=

# Optional SMTP settings for delivering the Contact form to informs@scu.edu.
# If these are left blank, the Contact form opens the visitor's email app instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=informs@scu.edu
